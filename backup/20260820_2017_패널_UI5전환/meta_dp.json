{
	"eula": "",
	"vendor": "dyunespace",
	"license": "",
	"id": "com.sap.sac.datepicker.glp",
	"version": "1.0.0",
	"name": "Datepicker Widget",
	"description": "Datepicker SAPUI5 for GLP",
	"icon": "data:image/svg+xml;base64,",
	"newInstancePrefix": "Datepicker",
	"webcomponents": [
		{
			"kind": "main",
			"tag": "com-sap-sac-datepicker-glp-main",
			"url": "https://dyunespace.github.io/datepicker/script_dp.js?v=20260820d",
			"integrity": "",
			"ignoreIntegrity": true
		},
		{
			"kind": "styling",
			"tag": "com-sap-sac-datepicker-glp-styling",
			"url": "https://dyunespace.github.io/datepicker/styling_dp.js?v=20260820d",
			"integrity": "",
			"ignoreIntegrity": true
		}
	],
	"properties": {
		"width": {
			"type": "integer",
			"default": 192
		},
		"height": {
			"type": "integer",
			"default": 32
		},
		"dateVal": {
			"type": "Date",
			"description": "default (start) date"
		},
		"secondDateVal": {
			"type": "Date",
			"description": "default end date (range mode)"
		},
		"dateMode": {
			"type": "string",
			"default": "day",
			"description": "day | week | month"
		},
		"weekRule": {
			"type": "string",
			"default": "ISO",
			"description": "week numbering rule. ISO = Monday start, week containing first Thursday is week 1 | JAN1 = Monday start, week containing Jan 1 is week 1 | US = Sunday start, week containing Jan 1 is week 1"
		},
		"format": {
			"type": "string",
			"description": "date format (varies by dateMode)",
			"default": ""
		},
		"enablerange": {
			"type": "boolean",
			"default": false
		},
		"fontFamily": {
			"type": "string",
			"default": "",
			"description": "CSS font-family. empty = inherit from SAC theme (Default)"
		},
		"fontSize": {
			"type": "integer",
			"default": 0,
			"description": "font size in px. 0 = inherit from SAC theme (Default)"
		},
		"fontStyle": {
			"type": "string",
			"default": "Regular",
			"description": "Regular | Italic | Bold | Bold Italic"
		},
		"fontColor": {
			"type": "string",
			"default": "",
			"description": "text color as hex. empty = inherit from SAC theme (Default)"
		},
		"minDateVal": {
			"type": "Date",
			"description": "The minimum Date value that can be selected. (optional)"
		},
		"maxDateVal": {
			"type": "Date",
			"description": "The maximum Date value that can be selected. (optional)"
		}
	},
	"methods": {
		"clear": {
			"description": "unset the selected date value"
		},
		"getDateVal": {
			"returnType": "Date",
			"description": "get the date. (start date if range selection is enabled, returns undefined when no date is selected)",
			"parameters": []
		},
		"setDateVal": {
			"description": "set the date. (start date if range selection is enabled)",
			"parameters": [
				{
					"name": "dv",
					"type": "Date",
					"description": "The new date"
				}
			],
			"body": "this.dateVal = dv;"
		},
		"getSecondDateVal": {
			"returnType": "Date",
			"description": "get the end date. (returns undefined if range selection is not enabled)",
			"parameters": []
		},
		"setSecondDateVal": {
			"description": "set the end date. (has no effect if range selection is not enabled)",
			"parameters": [
				{
					"name": "dv",
					"type": "Date",
					"description": "The new date"
				}
			],
			"body": "this.secondDateVal = dv;"
		},
		"getFormattedVal": {
			"returnType": "string",
			"description": "get the formatted string for the selected value. day: yyyy.MM.dd | week: YYYY.ww (YYYY = week-based year, may differ from calendar year) | month: yyyy.MM",
			"parameters": []
		},
		"getSecondFormattedVal": {
			"returnType": "string",
			"description": "get the formatted string for the end value. returns empty string if range selection is not enabled",
			"parameters": []
		},
		"setFormattedVal": {
			"description": "set the value from a formatted string, interpreted by the current dateMode. day: 2026.08.19 | week: 2026.34 | month: 2026.08. separators are ignored, so 20260819 / 2026-W34 also work. an empty string clears the value",
			"parameters": [
				{
					"name": "s",
					"type": "string",
					"description": "The formatted value"
				}
			]
		},
		"setSecondFormattedVal": {
			"description": "set the end value from a formatted string. has no effect if range selection is not enabled",
			"parameters": [
				{
					"name": "s",
					"type": "string",
					"description": "The formatted value"
				}
			]
		},
		"isRangeEnabled": {
			"description": "Returns whether range selection is enabled",
			"parameters": [],
			"returnType": "boolean",
			"body": "return this.enablerange;"
		},
		"getMinimumDateVal": {
			"returnType": "Date",
			"description": "get the date minimum. (might return undefined if value is not set)",
			"parameters": [],
			"body": "return this.minDateVal || undefined;"
		},
		"setMinimumDateVal": {
			"description": "set the date minimum.",
			"parameters": [
				{
					"name": "dv",
					"type": "Date",
					"description": "The new minimum date"
				}
			],
			"body": "this.minDateVal = dv;"
		},
		"clearMinimumDateVal": {
			"description": "clear the date minimum.",
			"body": "this.minDateVal = undefined;"
		},
		"getMaximumDateVal": {
			"returnType": "Date",
			"description": "get the date maximum. (might return undefined if value is not set)",
			"parameters": [],
			"body": "return this.maxDateVal || undefined;"
		},
		"setMaximumDateVal": {
			"description": "set the date maximum.",
			"parameters": [
				{
					"name": "dv",
					"type": "Date",
					"description": "The new maximum date"
				}
			],
			"body": "this.maxDateVal = dv;"
		},
		"clearMaximumDateVal": {
			"description": "clear the date maximum.",
			"body": "this.maxDateVal = undefined;"
		}
	},
	"events": {
		"onChange": {
			"description": "Called when the user changes the selected date."
		}
	}
}
